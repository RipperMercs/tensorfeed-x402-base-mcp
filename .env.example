# Optional: paid RPC provider for higher rate limits.
# If unset, falls back to public Base RPC (mainnet.base.org).
# Only URLs matching the allowlist in src/rpc/allowlist.ts are accepted.
TENSORFEED_RPC_URL=

# Optional: User-Agent suffix for outbound HTTP (e.g. when calling /.well-known/*).
# Useful for publishers debugging which agent hit them.
TENSORFEED_UA_SUFFIX=
